#!/bin/sh
set -eu

case ${1:-start} in
	start)
		umask 077
		mkdir -p /run/hhpt
		check_safety() {
			safety_phase=$1
			if safety_summary=$(/usr/bin/timeout -s KILL 5 /usr/bin/hhpt safety -output "/run/hhpt/safety-$safety_phase.json" -summary 2>"/run/hhpt/safety-$safety_phase.log"); then
				case "$safety_summary" in
					'writable_block_mounts=0 active_non_loop_interfaces=0') return ;;
				esac
			fi
			printf 'HHPT_SAFETY_FAIL stage=%s evidence=/run/hhpt/safety-%s.json detail=unsafe-or-incomplete-observations\n' "$safety_phase" "$safety_phase" > /dev/console
			exit 1
		}
		head -c 32 /dev/urandom > /run/hhpt/fingerprint.key
		ui_console=/dev/tty1
		if ! test -c "$ui_console"; then
			ui_console=/dev/console
		fi
		printf '\n=== HHSoft PC Tester ===\nLegacy BIOS/CSM hardware inspection (reduced coverage)\n\n' > /dev/console
		printf 'HHPT_UI_WAIT timeout=15s architecture=legacy-x86 assurance=legacy\n' > /dev/console
		if /usr/bin/hhpt ui -legacy -auto-start 15s -launch-selection-output /run/hhpt/launch-selection.json <"$ui_console" >"$ui_console" 2>&1; then
			ui_status=0
		else
			ui_status=$?
		fi
		# Outer deadlines are supervisor policy, not a proof of complete process cleanup.
		case $ui_status in
			0) profile=quick; session_timeout=5m; session_outer_timeout=350 ;;
			11) profile=standard; session_timeout=15m; session_outer_timeout=950 ;;
			*) printf 'HHPT_FAILED user-interface\n' > /dev/console; exit 1 ;;
		esac
		if ! test -f /run/hhpt/launch-selection.json || test -L /run/hhpt/launch-selection.json || ! chmod 0400 /run/hhpt/launch-selection.json; then
			printf 'HHPT_FAILED freeze-test-selection\n' > /dev/console
			exit 1
		fi
		printf 'HHPT_BOOT architecture=legacy-x86 mode=safe-%s assurance=legacy output=tmpfs\n' "$profile" > /dev/console
		if /usr/bin/hhpt inventory -fingerprint-key /run/hhpt/fingerprint.key -key-epoch ephemeral-session -output /run/hhpt/inventory.json; then
			grep -m 1 'hmac-sha256:' /run/hhpt/inventory.json > /dev/console || true
			component_count=$(grep -c '"type":' /run/hhpt/inventory.json || true)
			if test "$component_count" -eq 0; then
				printf 'HHPT_SAFETY_FAIL empty-inventory\n' > /dev/console
				exit 1
			fi
			check_safety preflight
			if /usr/bin/hhpt plan -fingerprint-key /run/hhpt/fingerprint.key -key-epoch ephemeral-session -profile "$profile" -architecture legacy-x86 -launch-selection-file /run/hhpt/launch-selection.json -output /run/hhpt/plan.json; then
				chmod 0400 /run/hhpt/plan.json || { printf 'HHPT_FAILED freeze-test-plan\n' > /dev/console; exit 1; }
				plan_id=$(sed -n 's/^[[:space:]]*"id": "\(sha256:[^"]*\)",*$/\1/p' /run/hhpt/plan.json | head -n 1)
				scheduled_count=$(grep -c '"status": "scheduled"' /run/hhpt/plan.json || true)
				unsupported_count=$(grep -c '"status": "unsupported"' /run/hhpt/plan.json || true)
				printf 'HHPT_PLAN id=%s profile=%s scheduled=%s unsupported=%s output=/run/hhpt/plan.json\n' "$plan_id" "$profile" "$scheduled_count" "$unsupported_count" > /dev/console
			else
				printf 'HHPT_FAILED test-plan\n' > /dev/console
				exit 1
			fi
			if /usr/bin/timeout -s KILL "$session_outer_timeout" /usr/bin/hhpt session -fingerprint-key /run/hhpt/fingerprint.key -key-epoch ephemeral-session -profile "$profile" -plan /run/hhpt/plan.json -evidence-dir /run/hhpt -timeout "$session_timeout" -output /run/hhpt/session.hhpcr <"$ui_console" >"$ui_console" 2>&1; then
				check_safety final
				if ! test -s /run/hhpt/session-ready.txt || test -L /run/hhpt/session-ready.txt || ! test -f /run/hhpt/session-ready.txt; then
					printf 'HHPT_FAILED session-ready-metadata\n' > /dev/console
					exit 1
				fi
				cat /run/hhpt/session-ready.txt > /dev/console
				/usr/bin/hhpt save -fingerprint-key /run/hhpt/fingerprint.key -audit-output /dev/console /run/hhpt/session.hhpcr <"$ui_console" >"$ui_console" 2>&1 || printf 'HHPT_SAVE_FAILED report-retained-in-ram\n' > /dev/console
			else
				session_status=$?
				printf 'HHPT_FAILED %s-session exit=%s cleanup=unconfirmed evidence=/run/hhpt\n' "$profile" "$session_status" > /dev/console
				exit 1
			fi
			while :; do sleep 3600; done
		else
			printf 'HHPT_FAILED inventory\n' > /dev/console
			exit 1
		fi
		;;
	*)
		;;
esac
